cff-version: 1.2.0
message: "If you use this dataset, please cite it as below."
type: dataset
title: "Belgian Chamber of Representatives Open Data: questions and speeches"
abstract: >-
  Structured data compiled from official documents of the
  Belgian Chamber of Representatives (dekamer.be): questions and speech transcripts
  from plenary meetings and committee meetings, in Parquet format. Content is in Dutch and French.
  Independent project, not affiliated with the Chamber.
authors:
  - name: "Partijgedrag België"
    website: "https://partijgedrag.be"
    email: "partijgedragbe@proton.me"
    orcid: "https://orcid.org/0009-0005-4451-8834"
license: CC-BY-4.0
repository-code: "https://github.com/partijgedragbe/dekamer-data"
url: "https://github.com/partijgedragbe/dekamer-data"      # fill in after the first Zenodo upload
version: "2026-11"
date-released: "2026-11-04"
keywords:
  - Belgium
  - parliament
  - Chamber of Representatives
  - Kamer van Volksvertegenwoordigers
  - Chambre des représentants
  - open data
  - legislative data
  - Parquet
